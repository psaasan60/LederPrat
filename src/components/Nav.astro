---
const links = [
	{ href: '/#tjenester', label: 'Tjenester' },
	{ href: '/#om', label: 'Om meg' },
	{ href: '/#referanser', label: 'Referanser' },
	{ href: '/#kontakt', label: 'Kontakt' },
];
---

<header class="border-b border-line bg-paper">
	<nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
		<a href="/" class="font-display text-xl font-medium tracking-tight text-ink">
			Leder<span class="text-brass">Partner</span>
		</a>

		<ul class="hidden items-center gap-8 font-body text-sm font-medium text-grey sm:flex">
			{
				links.map((link) => (
					<li>
						<a href={link.href} class="transition-colors hover:text-ink">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<a
			href="/#kontakt"
			class="inline-flex items-center rounded-sm bg-ink px-5 py-2.5 font-body text-sm font-semibold text-paper transition-colors hover:bg-ink-soft"
		>
			Book en samtale
		</a>
	</nav>
</header>
