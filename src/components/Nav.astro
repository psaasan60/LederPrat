---
const links = [
	{ href: '/#tjenester', label: 'Tjenester' },
	{ href: '/#om', label: 'Om meg' },
	{ href: '/#referanser', label: 'Referanser' },
	{ href: '/#kontakt', label: 'Kontakt' },
];
---

<header class="border-b border-ink-soft bg-ink">
	<nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-3">
		<a href="/">
			<img src="/logo/lockup-nav.png" alt="Paul Aasan | Leder Partner" class="h-14 w-auto" />
		</a>

		<ul class="hidden items-center gap-8 font-body text-sm font-medium text-paper/80 sm:flex">
			{
				links.map((link) => (
					<li>
						<a href={link.href} class="transition-colors hover:text-brass">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<a
			href="/#kontakt"
			class="inline-flex items-center rounded-sm bg-brass px-5 py-2.5 font-body text-sm font-semibold text-ink transition-colors hover:bg-brass-soft"
		>
			Book en samtale
		</a>
	</nav>
</header>
