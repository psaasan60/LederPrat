---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('home', 'forside');
if (!entry) throw new Error('Fant ikke forside-innhold');
const { Content } = await render(entry);
const {
	heroEyebrow,
	heroTitle,
	heroHighlight,
	heroText,
	trialEyebrow,
	trialTitle,
	trialText,
	servicesEyebrow,
	servicesTitle,
	servicesText,
	services,
	omEyebrow,
	omTitle,
	omImage,
	testimonials,
	kontaktTitle,
	kontaktText,
	email,
	phone,
} = entry.data;
---

<Layout>
	<!-- Hero -->
	<section class="relative overflow-hidden border-b border-line bg-paper px-6 py-24 sm:py-32">
		<div class="absolute inset-x-0 top-0 h-1.5 bg-linear-to-r from-steel via-brass to-steel"></div>
		<div class="mx-auto max-w-3xl text-center">
			<p class="inline-block rounded-full bg-steel/10 px-4 py-1.5 font-body text-sm font-semibold uppercase tracking-[0.2em] text-steel">
				{heroEyebrow}
			</p>
			<h1 class="mt-6 font-display text-4xl leading-tight text-ink sm:text-6xl">
				{heroTitle} <span class="text-brass">{heroHighlight}</span>
			</h1>
			<p class="mx-auto mt-6 max-w-xl font-body text-lg leading-relaxed text-grey">
				{heroText}
			</p>
			<div class="mt-10 flex flex-wrap items-center justify-center gap-4">
				<a
					href="#kontakt"
					class="inline-flex items-center rounded-sm bg-ink px-7 py-3.5 font-body text-sm font-semibold text-paper transition-colors hover:bg-ink-soft"
				>
					Book en uforpliktende prat
				</a>
				<a
					href="#tjenester"
					class="inline-flex items-center rounded-sm border-2 border-steel/30 px-7 py-3.5 font-body text-sm font-semibold text-ink transition-colors hover:border-steel"
				>
					Se hva jeg tilbyr
				</a>
			</div>
		</div>
	</section>

	<!-- Tjenester -->
	<section id="tjenester" class="border-b border-line bg-ink px-6 py-16 sm:py-20">
		<div class="mx-auto max-w-5xl">
			<p class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-brass">{servicesEyebrow}</p>
			<h2 class="mt-3 font-display text-3xl text-paper sm:text-4xl">{servicesTitle}</h2>
			<p class="mt-4 max-w-2xl font-body leading-relaxed text-paper/70">
				{servicesText}
			</p>
			<div class="mt-10 grid gap-8 sm:grid-cols-3">
				{
					services.map((s) => (
						<div class="border-t-2 border-brass bg-ink-soft p-8">
							<h3 class="font-display text-xl text-paper">{s.title}</h3>
							<p class="mt-3 font-body text-sm leading-relaxed text-paper/60">{s.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Gratis prøvetime -->
	<section class="bg-paper px-6 py-16 sm:py-20">
		<div class="mx-auto max-w-3xl rounded-sm border-2 border-brass bg-paper-dim px-8 py-12 text-center sm:px-14">
			<p class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-brass">{trialEyebrow}</p>
			<h2 class="mt-3 font-display text-3xl text-ink sm:text-4xl">{trialTitle}</h2>
			<p class="mx-auto mt-4 max-w-xl font-body leading-relaxed text-grey">
				{trialText}
			</p>
			<a
				href="#kontakt"
				class="mt-8 inline-flex items-center rounded-sm bg-brass px-8 py-3.5 font-body text-sm font-semibold text-ink transition-colors hover:bg-brass-soft"
			>
				Book gratis prøvetime
			</a>
		</div>
	</section>

	<!-- Om meg -->
	<section id="om" class="border-b border-line bg-paper px-6 py-20 sm:py-28">
		<div class="mx-auto grid max-w-5xl items-center gap-12 sm:grid-cols-[0.8fr_1.2fr]">
			<div class="aspect-4/5 overflow-hidden border-2 border-brass/60 p-2">
				<img src={omImage} alt="Paul Aasan" class="h-full w-full object-cover object-top" />
			</div>
			<div>
				<p class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-brass">{omEyebrow}</p>
				<h2 class="mt-3 font-display text-3xl text-ink sm:text-4xl">{omTitle}</h2>
				<div class="mt-5 space-y-4 font-body leading-relaxed text-grey [&_p]:leading-relaxed">
					<Content />
				</div>
			</div>
		</div>
	</section>

	<!-- Referanser -->
	{
		testimonials && testimonials.length > 0 && (
			<section id="referanser" class="border-b border-mist-line bg-mist px-6 py-20 sm:py-28">
				<div class="mx-auto max-w-3xl text-center">
					<div class="font-display text-6xl leading-none text-steel-soft" aria-hidden="true">
						&ldquo;
					</div>
					<h2 class="mt-2 font-display text-3xl text-ink sm:text-4xl">Hva kundene sier</h2>
					<div class="mt-10 space-y-8">
						{testimonials.map((t) => (
							<blockquote>
								<p class="font-display text-xl leading-snug text-ink italic">&ldquo;{t.quote}&rdquo;</p>
								<footer class="mt-3 font-body text-sm uppercase tracking-wide text-steel">{t.author}</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>
		)
	}

	<!-- Kontakt -->
	<section id="kontakt" class="bg-ink px-6 py-20 text-center sm:py-28">
		<div class="mx-auto max-w-xl">
			<h2 class="font-display text-3xl text-paper sm:text-4xl">{kontaktTitle}</h2>
			<p class="mt-4 font-body leading-relaxed text-paper/70">
				{kontaktText}
			</p>
			<div class="mt-8 flex flex-col items-center gap-3">
				<a
					href={`mailto:${email}`}
					class="inline-flex items-center rounded-sm bg-brass px-8 py-3.5 font-body text-sm font-semibold text-ink transition-colors hover:bg-brass-soft"
				>
					{email}
				</a>
				<a href={`tel:${phone.replace(/\s/g, '')}`} class="font-body text-sm text-paper/70 hover:text-paper">
					{phone}
				</a>
			</div>
		</div>
	</section>
</Layout>
