---
import Layout from '../layouts/Layout.astro';

const services = [
	{
		title: 'Fast sparring',
		text: 'Ukentlige eller faste samtaler der du kan tenke høyt om drift, ansatte og vanskelige beslutninger med noen som har stått i det selv.',
	},
	{
		title: 'Akutt sparring',
		text: 'Når noe haster — en konflikt, en krevende kunde, en beslutning som ikke kan vente til neste styremøte.',
	},
	{
		title: 'Pilotprogram — 4 uker',
		text: 'Fire ukentlige samtaler à 60 minutter. Fokus på prioritering, lederrollen, struktur, ansvar/delegering og krevende samtaler.',
	},
];

const testimonials = [
	{
		quote: 'Placeholder — sitat fra en kunde kommer her når de første pilotkundene har gitt tilbakemelding.',
		author: 'Navn, tittel, bedrift',
	},
];
---

<Layout>
	<!-- Hero -->
	<section class="relative overflow-hidden border-b border-line bg-paper px-6 py-24 sm:py-32">
		<div class="absolute inset-x-0 top-0 h-1.5 bg-linear-to-r from-steel via-brass to-steel"></div>
		<div class="mx-auto max-w-3xl text-center">
			<p class="inline-block rounded-full bg-steel/10 px-4 py-1.5 font-body text-sm font-semibold uppercase tracking-[0.2em] text-steel">
				For ledere i små og mellomstore bedrifter
			</p>
			<h1 class="mt-6 font-display text-4xl leading-tight text-ink sm:text-6xl">
				Lederrollen kan være <span class="text-brass">ensom</span>
			</h1>
			<p class="mx-auto mt-6 max-w-xl font-body text-lg leading-relaxed text-grey">
				Man sitter ofte alene med ansvar, ansatte, vanskelige beslutninger og press — samtidig som man
				skal være tryggheten for alle andre. Jeg hjelper eiere og ledere som trenger noen å tenke høyt
				med.
			</p>
			<div class="mt-10 flex flex-wrap items-center justify-center gap-4">
				<a
					href="#kontakt"
					class="inline-flex items-center rounded-sm bg-ink px-7 py-3.5 font-body text-sm font-semibold text-paper transition-colors hover:bg-ink-soft"
				>
					Book en uforpliktende samtale
				</a>
				<a
					href="#tjenester"
					class="inline-flex items-center rounded-sm border-2 border-steel/30 px-7 py-3.5 font-body text-sm font-semibold text-ink transition-colors hover:border-steel"
				>
					Se hva jeg tilbyr
				</a>
			</div>
		</div>
	</section>

	<!-- Gratis prøvetime -->
	<section class="bg-paper px-6 py-16 sm:py-20">
		<div class="mx-auto max-w-3xl rounded-sm border-2 border-brass bg-paper-dim px-8 py-12 text-center sm:px-14">
			<p class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-brass">Uforpliktende</p>
			<h2 class="mt-3 font-display text-3xl text-ink sm:text-4xl">Book første timen — gratis</h2>
			<p class="mx-auto mt-4 max-w-xl font-body leading-relaxed text-grey">
				Ingen forpliktelser, ingen selgerprat. Vi tar en uforpliktende prøvetime på 30 minutter for å bli
				kjent og se om kjemien og formen stemmer — før du eventuelt bestemmer deg for å gå videre.
			</p>
			<a
				href="#kontakt"
				class="mt-8 inline-flex items-center rounded-sm bg-brass px-8 py-3.5 font-body text-sm font-semibold text-ink transition-colors hover:bg-brass-soft"
			>
				Book gratis prøvetime
			</a>
		</div>
	</section>

	<!-- Tjenester -->
	<section id="tjenester" class="border-b border-line bg-ink px-6 py-20 sm:py-28">
		<div class="mx-auto max-w-5xl">
			<p class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-brass">Hvordan jeg kan hjelpe</p>
			<h2 class="mt-3 font-display text-3xl text-paper sm:text-4xl">Trygg sparring, ærlige samtaler</h2>
			<p class="mt-4 max-w-2xl font-body leading-relaxed text-paper/70">
				Ikke klassisk teoretisk "business coaching" — men praktisk sparring fra en som kjenner
				lederhverdagen fra innsiden. Jeg kommer ikke nødvendigvis med alle svarene, men jeg lytter,
				utfordrer og hjelper deg å sortere tankene.
			</p>
			<div class="mt-12 grid gap-8 sm:grid-cols-3">
				{
					services.map((s) => (
						<div class="border-t-2 border-brass bg-ink-soft p-8">
							<h3 class="font-display text-xl text-paper">{s.title}</h3>
							<p class="mt-3 font-body text-sm leading-relaxed text-paper/60">{s.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Om meg -->
	<section id="om" class="border-b border-line bg-paper px-6 py-20 sm:py-28">
		<div class="mx-auto grid max-w-5xl items-center gap-12 sm:grid-cols-[0.8fr_1.2fr]">
			<div class="aspect-4/5 overflow-hidden border-2 border-brass/60 p-2">
				<img src="/images/paul-aasan.jpg" alt="Paul Aasan" class="h-full w-full object-cover object-top" />
			</div>
			<div>
				<p class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-brass">Om meg</p>
				<h2 class="mt-3 font-display text-3xl text-ink sm:text-4xl">Lederlivet fra innsiden</h2>
				<div class="mt-5 space-y-4 font-body leading-relaxed text-grey">
					<p>
						Jeg vet hvor mye ansvar det innebærer å drive en virksomhet — og hvor ensomt det til tider
						kan være.
					</p>
					<p>
						Gjennom mange år som daglig leder, virksomhetsdriver og prosjektansvarlig har jeg jobbet
						tett på mennesker, drift, struktur, kunder, ansatte og krevende beslutninger. Jeg har
						opplevd både vekst, omstilling, press og perioder hvor man står alene med ansvaret — blant
						annet innen retail og butikkdrift, lyd/scene/event, tekniske AV-løsninger, ERP- og
						systemarbeid, og prosjektledelse.
					</p>
					<p>
						Fellesnevneren gjennom hele karrieren har vært mennesker: kommunikasjon, samarbeid,
						motivasjon, kultur og praktisk ledelse i hverdagen.
					</p>
					<p>
						I dag bruker jeg erfaringen som sparringspartner for småbedriftseiere og ledere som trenger
						noen å tenke høyt med. Jeg tror mange ledere ikke trenger flere teorier — de trenger trygg
						sparring, ærlige samtaler og noen som forstår virkeligheten bak lederrollen.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Referanser -->
	<section id="referanser" class="border-b border-mist-line bg-mist px-6 py-20 sm:py-28">
		<div class="mx-auto max-w-3xl text-center">
			<div class="font-display text-6xl leading-none text-steel-soft" aria-hidden="true">&ldquo;</div>
			<h2 class="mt-2 font-display text-3xl text-ink sm:text-4xl">Hva kundene sier</h2>
			<div class="mt-10 space-y-8">
				{
					testimonials.map((t) => (
						<blockquote>
							<p class="font-display text-xl leading-snug text-ink italic">&ldquo;{t.quote}&rdquo;</p>
							<footer class="mt-3 font-body text-sm uppercase tracking-wide text-steel">{t.author}</footer>
						</blockquote>
					))
				}
			</div>
		</div>
	</section>

	<!-- Kontakt -->
	<section id="kontakt" class="bg-ink px-6 py-20 text-center sm:py-28">
		<div class="mx-auto max-w-xl">
			<h2 class="font-display text-3xl text-paper sm:text-4xl">Ingen leder bør stå alene med alt</h2>
			<p class="mt-4 font-body leading-relaxed text-paper/70">
				Ta kontakt for en uforpliktende samtale om hvordan Paul Aasan | Leder Partner kan hjelpe deg og
				bedriften din.
			</p>
			<div class="mt-8 flex flex-col items-center gap-3">
				<a
					href="mailto:psaasan@gmail.com"
					class="inline-flex items-center rounded-sm bg-brass px-8 py-3.5 font-body text-sm font-semibold text-ink transition-colors hover:bg-brass-soft"
				>
					psaasan@gmail.com
				</a>
				<a href="tel:+4791356000" class="font-body text-sm text-paper/70 hover:text-paper">
					+47 913 56 000
				</a>
			</div>
		</div>
	</section>
</Layout>
